{
  "name": "ai-saas-foundation",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.17.0",
  "engines": { "node": ">=24", "pnpm": "11.17.0" },
  "scripts": {
    "dev": "pnpm --filter @foundation/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "eval": "pnpm dlx promptfoo@0.121.19 eval -c evals/promptfooconfig.yaml"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
